# Akeyless (certificate auth)
AKEYLESS_ACCESS_ID=p-xxxxxxxxxxxx
AKEYLESS_CERT_DATA=<base64-encoded-client-cert>
AKEYLESS_KEY_DATA=<base64-encoded-client-key>
AKEYLESS_GATEWAY_URL=https://your-gateway.example.com:8000

# Custom Producer
PRODUCER_URL=http://rotator.rotator.svc.cluster.local:8080

# Ansible AWX/AAP
ANSIBLE_URL=https://ansible.example.com
ANSIBLE_ADMIN_USER=admin
ANSIBLE_ADMIN_PASSWORD=changeme
TARGET_USERNAME=svc-server-build
TARGET_INITIAL_PASSWORD=changeme
TARGET_USER_ID=0

# TLS verification (set to false for self-signed certs, true for production)
SKIP_TLS_VERIFY=true

# EDA (optional)
EDA_WEBHOOK_URL=http://ansible-eda.example.com:5000/endpoint
EDA_WEBHOOK_TOKEN=changeme
